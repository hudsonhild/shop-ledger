# Copy to .env and fill in. Never commit .env.
#
# Required. Get one at https://scrapecreators.com (10,000 free calls, no card).
SCRAPECREATORS_API_KEY=

# Where the database and rendered dashboard live. Defaults to ./data
# SHOPLEDGER_DATA_DIR=./data

# How many products get the full daily detail pull. Each costs 1 credit per day.
# Start at 50 while the model is bootstrapping; 100 once you trust the series.
# SHOPLEDGER_PANEL_SIZE=50

# Abort the run if fewer than this many credits remain, rather than writing a
# partial day that looks like a real collapse in sales.
# SHOPLEDGER_MIN_CREDITS=200

# Views per unit sold, used only to bootstrap attribution confidence before a
# product has 14 days of its own history.
# SHOPLEDGER_DEFAULT_VPU=2000

# Engagement weight. Higher values favour videos with a strong like rate over
# videos with raw reach. 0 disables engagement weighting entirely.
# SHOPLEDGER_ENGAGEMENT_K=10
